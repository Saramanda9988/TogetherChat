        <module>common-data</module>
        <module>common-cache</module>
        <module>common-mq</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip> <!-- common模块不需要打包成可执行jar -->
